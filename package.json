{
  "name": "keystone-payroll",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/db-migrate.mjs --status",
    "bootstrap-admin": "node --env-file-if-exists=.env scripts/bootstrap-admin.mjs",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.mjs",
    "check:routes": "node scripts/check-route-guards.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "pnpm test && pnpm --dir backend test && pnpm check:routes && pnpm build && pnpm check:secrets"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.511.0",
    "next": "^16.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "pg": "^8.16.0",
    "postcss": "8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.17"
  }
}
