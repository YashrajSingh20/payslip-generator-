# Keystone Payroll: environment variables.
# Copy to .env for local development. Never commit real values.
# The backend reads this same file (`pnpm --dir backend dev` loads ../.env).

# --- Frontend (Next.js / Vercel) --------------------------------------------
# Server-only. Next rewrites /api/* to this origin, so the browser stays same-origin.
# Must be https in production.
BACKEND_ORIGIN=http://127.0.0.1:8080

# --- Backend: runtime -------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=8080
# Comma-separated frontend origins allowed to make state-changing requests (CSRF guard).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORTAL_TIMEZONE=Asia/Kolkata

# --- Backend: database ------------------------------------------------------
# Local Docker Postgres from compose.yaml (host port 5435).
DATABASE_URL=postgres://payroll:payroll_local_only@127.0.0.1:5435/keystone_payroll
# Used by migrations and admin scripts. Falls back to DATABASE_URL when blank.
DATABASE_ADMIN_URL=
# Local only. Production refuses DATABASE_SSL=false.
DATABASE_SSL=false
# Production: path to the RDS CA bundle inside the image, e.g. ./certs/ap-south-1-rds-ca.pem
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=10

# --- Backend: auth ----------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_DAYS=7
OTP_TTL_MINUTES=10

# --- Backend: email (Gmail API via OAuth2 refresh token) ---------------------
# All four of client id, client secret, refresh token and sender email must be
# set, or email stays off. The refresh token needs the
# https://www.googleapis.com/auth/gmail.send scope for the sender mailbox.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Keystone Commerce Payroll
EMAIL_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10

# --- Backend: uploads -------------------------------------------------------
MAX_WORKBOOK_BYTES=4194304
MAX_ROWS_PER_SHEET=5000

# --- Local development only (ignored when NODE_ENV=production) --------------
# Fixes the sign-in OTP to 123456 and skips sending it.
DEV_AUTH_BYPASS=true
# Writes emails to backend/.dev-mail/*.eml instead of sending them
# (used only when Gmail is not configured).
DEV_EMAIL_MOCK=true

# Team Portal employee sync. Payroll reads the roster from
# <TEAM_PORTAL_ORIGIN>/api/integrations/employees. Both values must be set or
# the sync stays off. The token must match PAYROLL_SYNC_TOKEN in the Team Portal
# (random, at least 32 characters).
TEAM_PORTAL_ORIGIN=
TEAM_PORTAL_SYNC_TOKEN=
TEAM_PORTAL_SYNC_MINUTES=60

# Private files (approved payslip PDFs, uploaded logos). Leave blank locally:
# files go to backend/.dev-storage instead. Required in production (S3).
PRIVATE_ASSET_BUCKET=
AWS_REGION=ap-south-1
