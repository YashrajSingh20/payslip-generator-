# Keystone Payroll: production deployment inputs (AWS).
#
#   cp backend/infra/production.env.example backend/infra/production.env
#   # fill it in, then:
#   bash backend/infra/create-secrets.sh   # stores the SECRET values in AWS SSM
#   bash backend/infra/deploy.sh           # creates / updates the AWS stack
#
# production.env is git-ignored. Both scripts read it automatically.
# Everything here is either a plain stack setting or a secret that
# create-secrets.sh copies into SSM Parameter Store (SecureString); the
# running API never reads this file.

# ---------------------------------------------------------------------------
# AWS account
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Source code (CodeBuild pulls main from here on every push)
# ---------------------------------------------------------------------------
# HTTPS URL of this repository after the transfer.
GITHUB_REPOSITORY_URL=https://github.com/<owner>/keystone-payroll.git
# An AVAILABLE AWS CodeConnections GitHub connection that can see the repo
# (the Team Portal's connection works if it has access to this repo):
#   aws codeconnections list-connections --region ap-south-1 \
#     --query 'Connections[?ConnectionStatus==`AVAILABLE`].[ConnectionArn,ConnectionName]' --output table
GITHUB_CONNECTION_ARN=arn:aws:codeconnections:ap-south-1:<account-id>:connection/<id>
# Branch that deploys production.
DEPLOY_BRANCH=main

# ---------------------------------------------------------------------------
# Network (the API and the migration job run inside this VPC)
# ---------------------------------------------------------------------------
# Same VPC as the database. Private subnets that have NAT internet access
# (Gmail, Team Portal, AWS APIs), comma-separated, at least two AZs.
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
SUBNET_IDS=subnet-aaaaaaaaaaaaaaaaa,subnet-bbbbbbbbbbbbbbbbb
# Security group of the RDS instance. When set, the stack adds one inbound
# PostgreSQL rule from the payroll API / migration job. Leave blank only if the
# database already admits traffic from these subnets' NAT addresses.
DATABASE_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# Public payroll URL on Vercel, https, no trailing slash. The API only accepts
# changes from this origin.
FRONTEND_ORIGIN=https://payroll.keystonecommerce.in

# ---------------------------------------------------------------------------
# Email (Gmail API). Sign-in codes and payslips are sent from this mailbox.
# ---------------------------------------------------------------------------
GMAIL_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_SENDER_EMAIL=payroll@keystonecommerce.in
GMAIL_SENDER_NAME=Keystone Commerce Payroll

# ---------------------------------------------------------------------------
# Team Portal employee sync
# ---------------------------------------------------------------------------
# Team Portal PRODUCTION API origin (its App Runner URL, or the portal's own
# domain since it forwards /api/integrations/*). Blank turns the sync off.
TEAM_PORTAL_ORIGIN=https://<team-portal-prod-api>

# ===========================================================================
# SECRETS: copied to SSM by create-secrets.sh under /keystone-payroll/prod/.
# Existing parameters are left alone unless FORCE=true, so re-running the
# script never rotates a secret by accident. Clear these lines afterwards if
# you don't want them on disk.
# ===========================================================================

# Runtime database user (read/write data only). Percent-encode special
# characters in the password. See docs/DEPLOYMENT.md, step 1.
DATABASE_URL=postgres://payroll_app:<password>@<rds-endpoint>:5432/keystone_payroll
# Schema owner, used only by the migration job (and the first-admin step).
DATABASE_ADMIN_URL=postgres://payroll_admin:<password>@<rds-endpoint>:5432/keystone_payroll

# Gmail OAuth client secret and a refresh token for GMAIL_SENDER_EMAIL with the
# https://www.googleapis.com/auth/gmail.send scope.
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Leave blank to generate (48 random bytes). Signs sign-in sessions.
JWT_SECRET=
# Leave blank to generate. MUST equal the Team Portal's
# /keystone-team-portal/prod/payroll-sync-token. The script prints where to put it.
TEAM_PORTAL_SYNC_TOKEN=
